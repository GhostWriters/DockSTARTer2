[metadata]
name = "RetroDockSTARTer"
description = "The retro DockSTARTer2 theme"
author = "CLHatch"

[syntax]
semantic_prefix = "{{|"
semantic_suffix = "|}}"
direct_prefix   = "{{["
direct_suffix   = "]}}"

[palette]
primary = "white"
secondary = "black"
screen_bg = "magenta"
accent = "$screen_bg"

[styles]
## Backdrop
Screen = "{{[$secondary:$accent]}}"
StatusBar = "{{|Dialog|}}"
Helpline = "{{|Dialog|}}"
# StatusBarBorder = "{{|StatusBar|}}"
# ConsoleBorder = "{{|Helpline|}}"

## Dialogs and panels
Dialog = "{{[$secondary:$primary]}}"
Border = "{{[$accent:$primary]}}"
Border2 = "{{[$secondary:$primary]}}"
Shadow = "{{|Screen:::D|}}"
ProgramBox = "{{[white:black:-]}}"

## Header bar
StatusFields = "{{[-]}}"
StatusName = "{{|Screen:::RB|}}"
# StatusVersion = "{{|StatusFields|}}"
# StatusVersionBrackets = "{{|StatusFields|}}"
# StatusVersionSpace = "{{[-]}}"
StatusVersionFocused = "{{[white:red:B]}}"
StatusFlags = "{{|StatusFields|}}"
StatusFlagsBrackets = "{{|StatusFields:::R|}}"
StatusFlagsSpace = "{{[$accent:black]}}"
StatusUpdate = "{{|StatusFields:$accent::BU|}}"
StatusUpdateBrackets = "{{|StatusFields|}}"
# StatusUpdateMarker = "{{|StatusUpdate|}}"
# StatusHostname = "{{|StatusFields|}}"
# StatusBarFocused = "{{|TagFocused|}}"

## Titles
Title = "{{[red:white:B]}}"
TitleHelp = "{{[red:white:B]}}"
TitleNotice = "{{[white:green:B]}}"
TitleWarn = "{{[black:yellow]}}"
TitleError = "{{[black:red]}}"
TitleSuccess = "{{[black:green]}}"
TitleWarning = "{{[black:yellow]}}"
TitleQuestion = "{{[black:yellow]}}"
TitleConsole = "{{|ConsoleBorder|}}"
TitleConsoleChangedIndicator = "{{|TitleNotice|}}"
TitleCheckbox = ""
TitleCheckboxFocused = "{{|TitleSubMenuFocused|}}"
TitleSubMenuFocused = "{{|Title:::R|}}"
TitleFocusIndicator = "{{[$accent:-B]}}"
TitleUnfocusedIndicator = ""

## Large Titles
LargeTitleArea = "{{|Dialog|}}"
# LargeTitleAreaHelp = "{{|LargeTitleArea|}}"
# LargeTitleAreaNotice = "{{|LargeTitleArea|}}"
# LargeTitleAreaWarn = "{{|LargeTitleArea|}}"
# LargeTitleAreaWarning = "{{|LargeTitleArea|}}"
# LargeTitleAreaError = "{{|LargeTitleArea|}}"
# LargeTitleAreaSuccess = "{{|LargeTitleArea|}}"
# LargeTitleAreaQuestion = "{{|LargeTitleArea|}}"
LargeTitle = "{{|Title|}}"
LargeTitleHelp = "{{|LargeTitle|}}"
# LargeTitleFocusIndicator = "{{|TitleFocusIndicator|}}"
# LargeTitleUnfocusedIndicator = "{{|TitleUnfocusedIndicator|}}"
LargeIconFocused = "{{|IconFocused|}}"
LargeIconPressed = "{{[red:white:B]}}"

## Subtitles
Subtitle = "{{[-:-:RB]}}"
CommandLine = "{{[-]}}{{[::B]}}"

## Headings
Heading = "{{[$primary:$secondary:B]}}"
HeadingTag = "{{[$secondary:$primary]}}"
HeadingValue = "{{[-:-:-RB]}}"
HeadingAppDescription = "{{[-:-:-B]}}"

## Menus
TagBrackets = "{{|Dialog|}}"
TagSpinner = ""
TagKey = "{{[red:white:B]}}"
Tag = "{{|Dialog|}}"
Item = "{{[black:$accent]}}"
TagKeyFocused = "{{[white:red:B]}}"
TagFocused = "{{[white:red]}}"
ItemFocused = "{{[white:red:B]}}"
# ItemListFocused = "{{|ItemFocused|}}"
# ItemListUserDefinedFocused = "{{|ItemFocused|}}"
ItemList = ""
ItemListUserDefined = "{{[magenta:black:B]}}"
ItemListDeprecated = "{{[red:black:B]}}"
ItemListDeprecatedFocused = "{{|ItemFocused|}}"
OptionValue = "{{[white:$accent:B]}}"
OptionValueFocused = "{{|OptionValue:::R|}}"

## Help
# HelpTag = "{{|Tag|}}"
HelpItem = "{{|Item|}}"

## Checkboxes
# Checkbox*Focused optionally falls back to TagFocused if undefined --
# uncomment and set to override checkbox focus styling specifically.
# CheckboxOffFocused = "{{|TagFocused|}}"
# CheckboxOnFocused = "{{|TagFocused|}}"
# CheckboxBracketsOffFocused = "{{|TagFocused|}}"
# CheckboxBracketsOnFocused = "{{|TagFocused|}}"
# CheckboxOff = "{{|Dialog|}}"
# CheckboxOn = "{{|TagKey|}}"
# CheckboxBracketsOff = "{{|Dialog|}}"
# CheckboxBracketsOn = "{{|Dialog|}}"

## Radio buttons
# Radio* falls back to the matching Checkbox* tag automatically, and any
# Checkbox*Focused/Radio*Focused tag falls back further to TagFocused --
# uncomment and set to override radio buttons specifically.
# RadioOff = "{{|CheckboxOff|}}"
# RadioOn = "{{|CheckboxOn|}}"
# RadioBracketsOff = "{{|CheckboxBracketsOff|}}"
# RadioBracketsOn = "{{|CheckboxBracketsOn|}}"
# RadioOffFocused = "{{|CheckboxOffFocused|}}"
# RadioOnFocused = "{{|CheckboxOnFocused|}}"
# RadioBracketsOffFocused = "{{|CheckboxBracketsOffFocused|}}"
# RadioBracketsOnFocused = "{{|CheckboxBracketsOnFocused|}}"

## Buttons
ButtonActive = "{{[white:red:B]}}"
ButtonInactive = "{{|Dialog|}}"
ButtonSpinner = ""
ButtonSpinnerLarge = ""
ButtonKeyActive = "{{|ButtonActive|}}"
ButtonKeyInactive = "{{|ButtonInactive:red|}}"

## Icons
# Per-widget icon tags (IconHelpInactive, IconMaximizeFocused, etc.) are
# optional overrides -- any not defined here fall back to the generic
# IconInactive/IconFocused/IconPressed below. Large* variants fall back the
# same way to LargeIconFocused/LargeIconPressed; Large*IconInactive falls
# back to its own small (non-Large) tag instead, since there's no generic
# LargeIconInactive.
IconFocused = "{{|ButtonActive|}}"
IconPressed = "{{[red:white:B]}}"
IconInactive = ""
IconExitInactive = "{{[::R]}}"
# Optional per-widget overrides -- uncomment to override that widget
# specifically.
# IconResizeUpInactive = "{{[-]}}"
# IconResizeDnInactive = "{{[-]}}"
# IconHelpInactive = "{{|IconInactive|}}"
# IconHelpFocused = "{{|IconFocused|}}"
# IconHelpPressed = "{{|IconPressed|}}"
# LargeIconHelpInactive = "{{|IconHelpInactive|}}"
# LargeIconHelpFocused = "{{|LargeIconFocused|}}"
# LargeIconHelpPressed = "{{|LargeIconPressed|}}"
# IconRefreshInactive = "{{|IconInactive|}}"
# IconRefreshFocused = "{{|IconFocused|}}"
# IconRefreshPressed = "{{|IconPressed|}}"
# LargeIconRefreshInactive = "{{|IconRefreshInactive|}}"
# LargeIconRefreshFocused = "{{|LargeIconFocused|}}"
# LargeIconRefreshPressed = "{{|LargeIconPressed|}}"
# LargeIconExitInactive = "{{|IconExitInactive|}}"
# IconExitFocused = "{{|IconFocused|}}"
# IconExitPressed = "{{|IconPressed|}}"
# LargeIconExitFocused = "{{|LargeIconFocused|}}"
# LargeIconExitPressed = "{{|LargeIconPressed|}}"
# IconMaximizeInactive = "{{|IconInactive|}}"
# IconMaximizeFocused = "{{|IconFocused|}}"
# IconMaximizePressed = "{{|IconPressed|}}"
# LargeIconMaximizeInactive = "{{|IconMaximizeInactive|}}"
# LargeIconMaximizeFocused = "{{|LargeIconFocused|}}"
# LargeIconMaximizePressed = "{{|LargeIconPressed|}}"
# IconSideBySideInactive = "{{|IconInactive|}}"
# IconSideBySideFocused = "{{|IconFocused|}}"
# IconSideBySidePressed = "{{|IconPressed|}}"
# LargeIconSideBySideInactive = "{{|IconSideBySideInactive|}}"
# LargeIconSideBySideFocused = "{{|LargeIconFocused|}}"
# LargeIconSideBySidePressed = "{{|LargeIconPressed|}}"
# IconStackedInactive = "{{|IconInactive|}}"
# IconStackedFocused = "{{|IconFocused|}}"
# IconStackedPressed = "{{|IconPressed|}}"
# LargeIconStackedInactive = "{{|IconStackedInactive|}}"
# LargeIconStackedFocused = "{{|LargeIconFocused|}}"
# LargeIconStackedPressed = "{{|LargeIconPressed|}}"

## Env editor variable types
EnvBuiltin = "{{|Dialog:::B|}}"
EnvInvalid = "{{|Dialog::red|]}}"
EnvDuplicate = "{{|Dialog::$accent|}}"
EnvPendingDelete = "{{|Dialog:::DS|}}"
EnvReadOnly = "{{|Dialog:::D|}}"

## Env editor
LineComment = "{{[$secondary:$primary:-B]}}"
ModifiedText = "{{[$primary:$secondary:-D]}}"

## Env editor line numbers
LineNumber = "{{[$secondary:$primary:-D]}}"
LineNumberFocused = "{{|LineNumber:$accent::-B|}}"
LineNumberModified = "{{|ModifiedText|}}"
LineNumberModifiedFocused = "{{|LineNumberModified:$accent::-B|}}"
LineNumberBrackets = "{{|Dialog|}}"

## Markers and cursor
Marker = "{{|Dialog|}}"
MarkerAdded = "{{|Marker::green|}}"
MarkerDeleted = "{{|Marker::red|}}"
MarkerModified = "{{|Marker::yellow|}}"
MarkerInvalid = "{{[white:red:B]}}"
MarkerLocked = "{{|MarkerInvalid|}}"
MarkerLockedLarge = "{{|MarkerLocked|}}"
TextCursor = "{{[magenta:yellow:B]}}"

## Scrollbar
Scrollbar = "{{|Border2|}}"
ScrollbarThumb = "{{|Border|}}"
ScrollbarArrows = "{{|Border|}}"

## Keys, progress, and indicators
KeyCap = "{{[::-R]}}"
ProgressWaiting = "{{[white:black:B]}}"
ProgressInProgress = "{{[$secondary:$primary]}}"
ProgressCompleted = "{{[$secondary:$primary:B]}}"

## Inline text highlights
Highlight = "{{[$primary:$secondary:B]}}"
# ApplicationName = "{{|Highlight|}}"
# RunningCommand = "{{|Highlight|}}"
FailingCommand = "{{|TitleError|}}"
# UserCommand = "{{|Highlight|}}"
# Branch = "{{|Highlight|}}"
Version = "{{|StatusVersion|}}"
# MenuPage = "{{|Highlight|}}"
# File = "{{|Highlight|}}"
# Folder = "{{|Highlight|}}"
# App = "{{|Highlight|}}"
# IPAddress = "{{|Highlight|}}"
URL = "{{|Highlight:::U|}}"
# Var = "{{|Highlight|}}"
# User = "{{|Highlight|}}"
# Theme = "{{|Highlight|}}"
Yes = "{{|TitleSuccess|}}"
No = "{{|TitleError|}}"

[defaults]
dialog_title_align = "center"
submenu_title_align = "left"
panel_title_align = "center"
shadow = true
border_color = 3
line_number_brackets = true
