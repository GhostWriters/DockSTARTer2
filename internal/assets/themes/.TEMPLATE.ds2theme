## Env editor variable types
# EnvBuiltin       = "{{[-:-:D]}}"
# EnvInvalid       = "{{|MarkerInvalid|}}"
# EnvDuplicate     = "{{|Highlight|}}"
# EnvPendingDelete = "{{[-:-:DS]}}"
# EnvReadOnly      = "{{[-:-:D]}}"

## Env editor
# LineComment  = "{{[-:-:D]}}"
