[metadata]
name        = "Tinted Theming"
description = "DockSTARTer2 theme to use with tinted-theming color sets"
author      = "CLHatch"
variant     = "tinted"
colors      = ["$primary", "$secondary", "$accent"]

[syntax]
semantic_prefix = "{{|"
semantic_suffix = "|}}"
direct_prefix   = "{{["
direct_suffix   = "]}}"

[palette]
# Named after their base16/base24 slot (see tinted-theming/base24's
# styling.md) rather than a literal ANSI color name -- both spellings are
# the same color (see semstyle's ansiColorIndex), base0X just reads the
# same as the scheme file itself. Chosen per that doc's own documented
# usage guidance for each slot. Meant for use with a tint; without one,
# the eight slots with no ANSI color (base01/02/04/06/09/0F/10/11) use the
# ANSI color they're a variant of.
primary         = "base05" # Default Foreground, Caret, Delimiters, Operators
secondary       = "base00" # Default Background
muted           = "base03" # Comments, Invisibles, Line Highlighting; "Inactive elements"
subtle          = "base04" # Dark Foreground; "Menu elements" option text
selection       = "base02" # Selection Background; "Selected elements"
darkest         = "base11" # The Darkest Background (base24)
highlight       = "base07" # The Lightest Foreground
accent          = "base0d" # Functions, Methods, Attribute IDs, Headings; key letters, highlights
success         = "base0b" # Strings, Diff Inserted -- green, conventional success (not itself a base24-documented category)
caution         = "base0a" # Classes, Markup Bold, Search Text Background -- yellow, for help and questions
warning         = "base0f" # "Warning elements"
error           = "base08" # Variables, Diff Deleted; also the documented "Alert elements" color
info            = "base0c" # Support, Regular Expressions, Escape Characters, Markup Quotes -- cyan
special         = "base0e" # Keywords, Storage, Selector, Markup Italic, Diff Changed -- magenta
status_fg       = "base04" # Dark Foreground (Used for status bars)
status_bg       = "base01" # Lighter Background (Used for status bars)
field_bg        = "base01" # Lighter Background -- input fields
title_bg        = "base02" # Selection Background -- the large title bar
diff_inserted   = "base0b" # Diff Inserted
diff_deleted    = "base08" # Diff Deleted
diff_changed    = "base0e" # Diff Changed
border1         = "base05" # Borders of "normal elements"
border2         = "base03" # Borders of "inactive elements"
focus_highlight = "base0d" # "Focus elements": focused titles, tabs, and buttons
focus_border    = "base05" # "Focus elements" borders: the focus indicators

[styles]
## Backdrop
  StatusBar       = "{{[$status_fg:$status_bg]}}"  # = "{{[-:-:R]}}"
# StatusBarBorder = "{{|StatusBar|}}"
  Screen          = "{{[$secondary:$primary]}}"    # = "{{[-:-:-]}}"
# Helpline        = "{{|StatusBar|}}"
# PanelBorder     = "{{|Helpline|}}"

## Dialogs and panels
  Dialog     = "{{[$primary:$secondary]}}"  # = "{{[-:-:R]}}"
  Border     = "{{[$border1:$secondary]}}"  # = "{{|Dialog|}}"
  Border2    = "{{[$border2:$secondary]}}"  # = "{{|Border|}}"
  Shadow     = "{{[$darkest]}}"             # = "{{|Screen:::D|}}"
# ProgramBox = "{{[~]}}"

## Header bar
  StatusFields          = "{{|Screen|}}"                       # = "{{[-]}}"
  StatusName            = "{{[$accent:$primary:B]}}"           # = "{{|StatusFields|}}"
# StatusVersion         = "{{|StatusFields|}}"
# StatusVersionBrackets = "{{|StatusFields|}}"
# StatusVersionSpace    = "{{[-]}}"
  StatusVersionFocused  = "{{[$secondary:$focus_highlight]}}"  # = "{{|TagFocused|}}"
  StatusFlags           = "{{[$muted:$secondary:B]}}"          # = "{{[-]}}"
  StatusFlagsBrackets   = "{{|StatusFields|}}"                 # = "{{[-]}}"
  StatusFlagsSpace      = "{{|StatusFields|}}"                 # = "{{|StatusVersionSpace|}}"
  StatusUpdate          = "{{[$accent:$secondary:BU]}}"        # = "{{|Highlight|}}"
# StatusUpdateBrackets  = "{{|StatusVersionBrackets|}}"
# StatusUpdateMarker    = "{{|StatusUpdate|}}"
# StatusHostname        = "{{|StatusFields|}}"
# StatusBarFocused      = "{{|TagFocused|}}"

## Titles
  Title                      = "{{[$primary::-U]}}"                 # = "{{[-:-:UB]}}"
# TitleHelp                  = "{{|Title|}}"
  TitleNotice                = "{{[$primary:$success:B]}}"          # = "{{|Title|}}"
  TitleWarn                  = "{{[$secondary:$warning]}}"          # = "{{|Title|}}"
  TitleError                 = "{{[$secondary:$error:B]}}"          # = "{{|Title|}}"
  TitleSuccess               = "{{[$secondary:$success]}}"          # = "{{|Title|}}"
  TitleWarning               = "{{[$secondary:$warning]}}"          # = "{{|Title|}}"
  TitleQuestion              = "{{[$secondary:$caution]}}"          # = "{{|Title|}}"
# TitleSubMenu               = "{{|Title|}}"
# TitleFocused               = "{{|Title|}}"
  PanelTitle                 = "{{|PanelBorder|}}"
  PanelTitleChangedIndicator = "{{|TitleNotice:$secondary::B|}}"    # = "{{|Highlight|}}"
  TitleCheckbox              = ""
  TitleCheckboxFocused       = "{{|TitleSubMenuFocused|}}"          # = "{{|TitleFocused|}}"
  TitleSubMenuFocused        = "{{[$secondary:$focus_highlight]}}"  # = "{{|TitleFocused|}}"
# TitleHelpFocused           = "{{|TitleFocused|}}"
# TitleNoticeFocused         = "{{|TitleFocused|}}"
# TitleWarnFocused           = "{{|TitleFocused|}}"
# TitleWarningFocused        = "{{|TitleFocused|}}"
# TitleErrorFocused          = "{{|TitleFocused|}}"
# TitleSuccessFocused        = "{{|TitleFocused|}}"
# TitleQuestionFocused       = "{{|TitleFocused|}}"
  TitleFocusIndicator        = "{{[$focus_border::-B]}}"            # = "{{|Highlight|}}"
  TitleUnfocusedIndicator    = ""

## Large Titles
  LargeTitleArea                    = "{{[$primary:$title_bg:-]}}"              # = "{{|StatusBar|}}"
  LargeTitleAreaHelp                = "{{[$title_bg:$caution]}}"                # = "{{|LargeTitleArea|}}"
  LargeTitleAreaNotice              = "{{[$title_bg:$success]}}"                # = "{{|LargeTitleArea|}}"
  LargeTitleAreaWarn                = "{{[$title_bg:$warning]}}"                # = "{{|LargeTitleArea|}}"
  LargeTitleAreaWarning             = "{{[$title_bg:$warning]}}"                # = "{{|LargeTitleArea|}}"
  LargeTitleAreaError               = "{{[$title_bg:$error]}}"                  # = "{{|LargeTitleArea|}}"
  LargeTitleAreaSuccess             = "{{[$title_bg:$success]}}"                # = "{{|LargeTitleArea|}}"
  LargeTitleAreaQuestion            = "{{[$title_bg:$caution]}}"                # = "{{|LargeTitleArea|}}"
  LargeTitle                        = "{{[::U]}}"                               # = "{{|Title|}}"
# LargeTitleHelp                    = "{{|LargeTitle|}}"
# LargeTitleNotice                  = "{{|TitleNotice|}}"
# LargeTitleWarn                    = "{{|TitleWarn|}}"
# LargeTitleWarning                 = "{{|TitleWarning|}}"
# LargeTitleError                   = "{{|TitleError|}}"
# LargeTitleSuccess                 = "{{|TitleSuccess|}}"
# LargeTitleQuestion                = "{{|TitleQuestion|}}"
# LargeTitleFocusIndicator          = "{{|TitleFocusIndicator|}}"
# LargeTitleUnfocusedIndicator      = "{{|TitleUnfocusedIndicator|}}"
# TitleControlCheckboxOn            = "{{|CheckboxOn|}}"
# TitleControlCheckboxOff           = "{{|CheckboxOff|}}"
# TitleControlCheckboxBrackets      = "{{|CheckboxBracketsOff|}}"
# TitleControlTag                   = "{{|Tag|}}"
# TitleControlTagKey                = "{{|TagKey|}}"
# TitleControlOptionValue           = "{{|OptionValue|}}"
# LargeTitleControlCheckboxOn       = "{{|LargeTitleControlCheckboxOff:::B|}}"
# LargeTitleControlCheckboxOff      = "{{[-]}}"
# LargeTitleControlCheckboxBrackets = "{{[-]}}"
# LargeTitleControlTag              = "{{[-]}}"
# LargeTitleControlTagKey           = "{{|LargeTitleControlTag:::B|}}"
# LargeTitleControlOptionValue      = "{{|LargeTitleControlTag|}}"
# LargeTitleSubMenu                 = "{{|TitleSubMenu|}}"
# LargeTitleSubMenuFocused          = "{{|TitleSubMenuFocused|}}"
# LargeTitleHelpFocused             = "{{|TitleHelpFocused|}}"
# LargeTitleNoticeFocused           = "{{|TitleNoticeFocused|}}"
# LargeTitleWarnFocused             = "{{|TitleWarnFocused|}}"
# LargeTitleWarningFocused          = "{{|TitleWarningFocused|}}"
# LargeTitleErrorFocused            = "{{|TitleErrorFocused|}}"
# LargeTitleSuccessFocused          = "{{|TitleSuccessFocused|}}"
# LargeTitleQuestionFocused         = "{{|TitleQuestionFocused|}}"
  LargeIconFocused                  = "{{|IconFocused|}}"
  LargeIconPressed                  = "{{[$secondary:$primary:B]}}"             # = "{{|IconPressed|}}"

## Subtitles
  Subtitle    = "{{[$muted::-]}}"  # = "{{|Dialog|}}"
  CommandLine = "{{[$primary]}}"   # = "{{|Dialog|}}"

## Headings
  Heading               = "{{[$primary::-B]}}"   # = "{{|Title|}}"
  HeadingTag            = "{{[$accent::-B]}}"    # = "{{|Heading|}}"
  HeadingValue          = "{{[$primary::-BU]}}"  # = "{{|Heading|}}"
  HeadingAppDescription = "{{[$muted]}}"         # = "{{|Heading|}}"

## Menus
  TagBrackets                 = "{{|Dialog|}}"
  TagSpinner                  = ""                                  # = "{{|Tag|}}"
  TagKey                      = "{{[$accent::-B]}}"                 # = "{{[-:-:B]}}"
  Tag                         = "{{[$subtle:$secondary:-]}}"        # = "{{[-:-:-]}}"
  Item                        = "{{|Dialog|}}"                      # = "{{[-:-:-]}}"
  TagKeyFocused               = "{{[$accent:$selection:-B]}}"       # = "{{|TagFocused|}}"
# PositionIndicator           = "{{|TagKey:::B|}}"
# ListCount                   = "{{|PositionIndicator|}}"
  TagFocused                  = "{{[$primary:$selection:-B]}}"      # = "{{[-:-:R]}}"
  ItemFocused                 = "{{[$primary:$selection:B]}}"       # = "{{[-:-:R]}}"
# ResizeLine                  = "{{|ItemFocused|}}"
# ItemListFocused             = "{{|ItemFocused|}}"
# ItemListUserDefinedFocused  = "{{|ItemFocused|}}"
# ItemListUserTemplateFocused = "{{|ItemListFocused:::U|}}"
# ItemListDeprecated          = "{{|ItemListUserDefined|}}"
# ItemListDeprecatedFocused   = "{{|ItemListUserDefinedFocused|}}"
  ItemList                    = ""                                  # = "{{|Item|}}"
  ItemListUserDefined         = "{{[$info::-]}}"                    # = "{{|Item|}}"
# ItemListUserTemplate        = "{{|ItemList:::U|}}"
  OptionValue                 = "{{[$accent::-B]}}"                 # = "{{|Dialog|}}"
  OptionValueFocused          = "{{[$primary:$selection:B]}}"       # = "{{|TagFocused|}}"

## Help
# HelpTag  = "{{|Tag|}}"
# HelpItem = "{{|Dialog|}}"

## Checkboxes
# CheckboxOffFocused         = "{{|TagFocused|}}"
# CheckboxOnFocused          = "{{|TagKeyFocused|}}"
# CheckboxBracketsOffFocused = "{{|TagFocused|}}"
# CheckboxBracketsOnFocused  = "{{|TagFocused|}}"
# CheckboxOff                = "{{|Tag|}}"
# CheckboxOn                 = "{{|TagKey|}}"
# CheckboxBracketsOff        = "{{|Tag|}}"
# CheckboxBracketsOn         = "{{|Tag|}}"

## Radio buttons
# RadioOff                = "{{|CheckboxOff|}}"
# RadioOn                 = "{{|CheckboxOn|}}"
# RadioBracketsOff        = "{{|CheckboxBracketsOff|}}"
# RadioBracketsOn         = "{{|CheckboxBracketsOn|}}"
# RadioOffFocused         = "{{|CheckboxOffFocused|}}"
# RadioOnFocused          = "{{|CheckboxOnFocused|}}"
# RadioBracketsOffFocused = "{{|CheckboxBracketsOffFocused|}}"
# RadioBracketsOnFocused  = "{{|CheckboxBracketsOnFocused|}}"

## Buttons
  ButtonActive       = "{{[$secondary:$focus_highlight:B]}}"  # = "{{[-:-:R]}}"
  ButtonInactive     = "{{|Dialog|}}"                         # = "{{[-:-:-]}}"
  ButtonSpinner      = ""                                     # = "{{|ButtonActive|}}"
  LargeButtonSpinner = ""                                     # = "{{|ButtonSpinner|}}"
  ButtonKeyActive    = "{{|ButtonActive|}}"
  ButtonKeyInactive  = "{{[$muted::-]}}"                      # = "{{|ButtonInactive|}}"

## Icons
  IconFocused                 = "{{|ButtonActive|}}"               # = "{{[-:-:R]}}"
  IconPressed                 = "{{[$secondary:$primary:B]}}"      # = "{{[-:-:RB]}}"
# IconDisabled                = "{{|IconInactive:::bD|}}"
  IconInactive                = ""
  IconExitInactive            = "{{[$error::-]}}"                  # = "{{|IconInactive|}}"
# IconResizeUpInactive        = "{{[-]}}"
# IconResizeUpFocused         = "{{|IconFocused|}}"
# IconResizeUpPressed         = "{{|IconPressed|}}"
# LargeIconResizeUpInactive   = "{{|IconResizeUpInactive|}}"
# LargeIconResizeUpFocused    = "{{|LargeIconFocused|}}"
# LargeIconResizeUpPressed    = "{{|LargeIconPressed|}}"
# IconResizeUpDisabled        = "{{|IconResizeUpInactive:::bD|}}"
# LargeIconResizeUpDisabled   = "{{|IconResizeUpDisabled|}}"
# IconResizeDnInactive        = "{{[-]}}"
# IconResizeDnFocused         = "{{|IconFocused|}}"
# IconResizeDnPressed         = "{{|IconPressed|}}"
# LargeIconResizeDnInactive   = "{{|IconResizeDnInactive|}}"
# LargeIconResizeDnFocused    = "{{|LargeIconFocused|}}"
# LargeIconResizeDnPressed    = "{{|LargeIconPressed|}}"
# IconResizeDnDisabled        = "{{|IconResizeDnInactive:::bD|}}"
# LargeIconResizeDnDisabled   = "{{|IconResizeDnDisabled|}}"
# IconHelpInactive            = "{{|IconInactive|}}"
# IconHelpFocused             = "{{|IconFocused|}}"
# IconHelpPressed             = "{{|IconPressed|}}"
# LargeIconHelpInactive       = "{{|IconHelpInactive|}}"
# LargeIconHelpFocused        = "{{|LargeIconFocused|}}"
# LargeIconHelpPressed        = "{{|LargeIconPressed|}}"
# IconHelpDisabled            = "{{|IconDisabled|}}"
# LargeIconHelpDisabled       = "{{|IconHelpDisabled|}}"
# IconRefreshInactive         = "{{|IconInactive|}}"
# IconRefreshFocused          = "{{|IconFocused|}}"
# IconRefreshPressed          = "{{|IconPressed|}}"
# LargeIconRefreshInactive    = "{{|IconRefreshInactive|}}"
# LargeIconRefreshFocused     = "{{|LargeIconFocused|}}"
# LargeIconRefreshPressed     = "{{|LargeIconPressed|}}"
# IconRefreshDisabled         = "{{|IconDisabled|}}"
# LargeIconRefreshDisabled    = "{{|IconRefreshDisabled|}}"
# LargeIconExitInactive       = "{{|IconExitInactive|}}"
# IconExitFocused             = "{{|IconFocused|}}"
# IconExitPressed             = "{{|IconPressed|}}"
# LargeIconExitFocused        = "{{|LargeIconFocused|}}"
# LargeIconExitPressed        = "{{|LargeIconPressed|}}"
# IconExitDisabled            = "{{|IconDisabled|}}"
# LargeIconExitDisabled       = "{{|IconExitDisabled|}}"
# IconMaximizeInactive        = "{{|IconInactive|}}"
# IconMaximizeFocused         = "{{|IconFocused|}}"
# IconMaximizePressed         = "{{|IconPressed|}}"
# LargeIconMaximizeInactive   = "{{|IconMaximizeInactive|}}"
# LargeIconMaximizeFocused    = "{{|LargeIconFocused|}}"
# LargeIconMaximizePressed    = "{{|LargeIconPressed|}}"
# IconMaximizeDisabled        = "{{|IconDisabled|}}"
# LargeIconMaximizeDisabled   = "{{|IconMaximizeDisabled|}}"
# IconSideBySideInactive      = "{{|IconInactive|}}"
# IconSideBySideFocused       = "{{|IconFocused|}}"
# IconSideBySidePressed       = "{{|IconPressed|}}"
# LargeIconSideBySideInactive = "{{|IconSideBySideInactive|}}"
# LargeIconSideBySideFocused  = "{{|LargeIconFocused|}}"
# LargeIconSideBySidePressed  = "{{|LargeIconPressed|}}"
# IconSideBySideDisabled      = "{{|IconDisabled|}}"
# LargeIconSideBySideDisabled = "{{|IconSideBySideDisabled|}}"
# IconStackedInactive         = "{{|IconInactive|}}"
# IconStackedFocused          = "{{|IconFocused|}}"
# IconStackedPressed          = "{{|IconPressed|}}"
# LargeIconStackedInactive    = "{{|IconStackedInactive|}}"
# LargeIconStackedFocused     = "{{|LargeIconFocused|}}"
# LargeIconStackedPressed     = "{{|LargeIconPressed|}}"
# IconStackedDisabled         = "{{|IconDisabled|}}"
# LargeIconStackedDisabled    = "{{|IconStackedDisabled|}}"

## Env editor variable types
  EnvBuiltin       = "{{[$subtle]}}"              # = "{{[-:-:D]}}"
  EnvInvalid       = "{{[$secondary:$error:B]}}"  # = "{{|MarkerInvalid|}}"
  EnvDuplicate     = "{{[$secondary:$warning]}}"  # = "{{|Highlight|}}"
  EnvPendingDelete = "{{[$diff_deleted::S]}}"     # = "{{[-:-:DS]}}"
  EnvReadOnly      = "{{[$muted]}}"               # = "{{[-:-:D]}}"

## Env editor
  LineComment  = "{{[$muted]}}"            # = "{{[-:-:D]}}"
  ModifiedText = "{{[$diff_changed::B]}}"  # = "{{|Highlight|}}"

## Env editor line numbers
  LineNumber                = "{{[$muted]}}"                      # = "{{[-:-:D]}}"
  LineNumberFocused         = "{{[$accent::B]}}"                  # = "{{|TagFocused|}}"
  LineNumberModified        = "{{|ModifiedText|}}"                # = "{{|Highlight|}}"
  LineNumberModifiedFocused = "{{[$secondary:$diff_changed:B]}}"  # = "{{|LineNumberModified|}}"
  LineNumberBrackets        = "{{|TagBrackets|}}"                 # = "{{|LineNumber|}}"

## Markers and cursor
  Marker                  = "{{[$secondary:$primary]}}"
  MarkerAdded             = "{{[$secondary:$diff_inserted]}}"  # = "{{|Highlight|}}"
  MarkerDeleted           = "{{[$secondary:$diff_deleted]}}"   # = "{{|MarkerInvalid|}}"
  MarkerModified          = "{{[$secondary:$diff_changed]}}"   # = "{{|Highlight|}}"
  MarkerInvalid           = "{{[$primary:$error:B]}}"          # = "{{[-:-:R]}}"
  MarkerLocked            = "{{|MarkerInvalid|}}"
# ButtonLockedMarker      = "{{|MarkerLocked|}}"
# LargeButtonLockedMarker = "{{|ButtonLockedMarker|}}"
# Prompt                  = "{{[-:-:B]}}"
# PromptShell             = "{{|Highlight|}}"
# PromptSudo              = "{{|MarkerInvalid|}}"
  InputField              = "{{[$primary:$field_bg]}}"
  TextCursor              = "{{[$secondary:$primary:-B]}}"     # = "{{[-:-:R]}}"
  TextCursorFlash         = "{{[$primary:$selection:B]}}"      # = "{{|TextCursor:::R|}}"

## Scrollbar
  Scrollbar       = "{{|Border2|}}"  # = "{{[-:-:D]}}"
  ScrollbarThumb  = "{{|Border|}}"   # = "{{|Scrollbar|}}"
  ScrollbarArrows = "{{|Border|}}"   # = "{{|Scrollbar|}}"

## Keys, progress, and indicators
  KeyCap             = "{{[$secondary:$accent]}}"    # = "{{[-:-:R]}}"
  ProgressWaiting    = "{{[$muted:$secondary]}}"     # = "{{[-:-:D]}}"
  ProgressInProgress = "{{[$accent:$secondary:B]}}"  # = "{{|Highlight|}}"
  ProgressCompleted  = "{{[$secondary:$success]}}"   # = "{{|Highlight|}}"

## Inline text highlights
  Highlight       = "{{[$accent::B]}}"     # = "{{[-:-:B]}}"
# ApplicationName = "{{|Highlight|}}"
# RunningCommand  = "{{|Highlight|}}"
  FailingCommand  = "{{|TitleError|}}"     # = "{{|MarkerInvalid|}}"
# UserCommand     = "{{|Highlight|}}"
# Branch          = "{{|Highlight|}}"
# Version         = "{{|Highlight|}}"
# MenuPage        = "{{|Highlight|}}"
# File            = "{{|Highlight|}}"
# Folder          = "{{|Highlight|}}"
# App             = "{{|Highlight|}}"
# UserApp         = "{{|Highlight|}}"
# IPAddress       = "{{|Highlight|}}"
  URL             = "{{|Highlight:::U|}}"  # = "{{[-:-:U]}}"
# Var             = "{{|Highlight|}}"
# User            = "{{|Highlight|}}"
# Theme           = "{{|Highlight|}}"
# Tint            = "{{|Theme|}}"
  Yes             = "{{[$success::B]}}"    # = "{{|Highlight|}}"
  No              = "{{[$error::B]}}"      # = "{{|TitleError|}}"

[defaults]
# borders              = true
# large_buttons        = true
# large_title_bars     = true
# line_characters      = true
  shadow               = true
# shadow_level         = 2
# scrollbar            = true
# spinner              = true
# menu_brackets        = true
# checkbox_brackets    = "always"
# radio_brackets       = "always"
  border_color         = 3
  dialog_title_align   = "center"
  submenu_title_align  = "left"
  panel_title_align    = "center"
# tab_layout           = "sidebyside"
  line_number_brackets = true
