[metadata]
name        = "Murica"
description = "DockSTARTer2 Murica Heck Yea! theme"
author      = "Westlin"

[syntax]
semantic_prefix = "{{|"
semantic_suffix = "|}}"
direct_prefix   = "{{["
direct_suffix   = "]}}"

[palette]
accent = "blue"

[styles]
## Backdrop
  StatusBar       = "{{|Dialog|}}"        # = "{{[-:-:R]}}"
# StatusBarBorder = "{{|StatusBar|}}"
  Screen          = "{{[white:blue:B]}}"  # = "{{[-:-:-]}}"
# Helpline        = "{{|StatusBar|}}"
# PanelBorder     = "{{|Helpline|}}"

## Dialogs and panels
  Dialog     = "{{[red:white]}}"   # = "{{[-:-:R]}}"
  Border     = "{{[red:white]}}"   # = "{{|Dialog|}}"
  Border2    = "{{[blue:white]}}"  # = "{{|Border|}}"
# Shadow     = "{{|Screen:::D|}}"
# ProgramBox = "{{[~]}}"

## Header bar
  StatusFields          = "{{[blue:white]}}"        # = "{{[-]}}"
  StatusName            = "{{|StatusFields:::R|}}"  # = "{{|StatusFields|}}"
# StatusVersion         = "{{|StatusFields|}}"
# StatusVersionBrackets = "{{|StatusFields|}}"
# StatusVersionSpace    = "{{[-]}}"
  StatusVersionFocused  = "{{[blue:white:B]}}"      # = "{{|TagFocused|}}"
  StatusFlags           = "{{[white:blue]}}"        # = "{{[-]}}"
  StatusFlagsBrackets   = "{{|StatusFields|}}"      # = "{{[-]}}"
  StatusFlagsSpace      = "{{|StatusFields|}}"      # = "{{|StatusVersionSpace|}}"
  StatusUpdate          = "{{[white:blue]}}"        # = "{{|Highlight|}}"
  StatusUpdateBrackets  = "{{[white:blue]}}"        # = "{{|StatusVersionBrackets|}}"
# StatusUpdateMarker    = "{{|StatusUpdate|}}"
# StatusHostname        = "{{|StatusFields|}}"
# StatusBarFocused      = "{{|TagFocused|}}"

## Titles
  Title                      = "{{[red:white:U]}}"          # = "{{[-:-:UB]}}"
# TitleHelp                  = "{{|Title|}}"
  TitleNotice                = "{{[white:green:B]}}"        # = "{{|Title|}}"
  TitleWarn                  = "{{|Title::yellow|}}"        # = "{{|Title|}}"
  TitleError                 = "{{|Title::red|}}"           # = "{{|Title|}}"
  TitleSuccess               = "{{|Title::green|}}"         # = "{{|Title|}}"
  TitleWarning               = "{{|Title::yellow|}}"        # = "{{|Title|}}"
  TitleQuestion              = "{{[white:blue]}}"           # = "{{|Title|}}"
# TitleSubMenu               = "{{|Title|}}"
# TitleFocused               = "{{|Title|}}"
  PanelTitle                 = "{{|PanelBorder|}}"
  PanelTitleChangedIndicator = "{{|TitleNotice|}}"          # = "{{|Highlight|}}"
  TitleCheckbox              = ""
  TitleCheckboxFocused       = "{{|TitleSubMenuFocused|}}"  # = "{{|TitleFocused|}}"
  TitleSubMenuFocused        = "{{|Title:::R|}}"            # = "{{|TitleFocused|}}"
# TitleHelpFocused           = "{{|TitleFocused|}}"
# TitleNoticeFocused         = "{{|TitleFocused|}}"
# TitleWarnFocused           = "{{|TitleFocused|}}"
# TitleWarningFocused        = "{{|TitleFocused|}}"
# TitleErrorFocused          = "{{|TitleFocused|}}"
# TitleSuccessFocused        = "{{|TitleFocused|}}"
# TitleQuestionFocused       = "{{|TitleFocused|}}"
  TitleFocusIndicator        = "{{[red::-B]}}"              # = "{{|Highlight|}}"
  TitleUnfocusedIndicator    = ""

## Large Titles
  LargeTitleArea               = "{{[white:blue:-]}}"             # = "{{|StatusBar|}}"
# LargeTitleAreaHelp           = "{{|LargeTitleArea|}}"
# LargeTitleAreaNotice         = "{{|LargeTitleArea|}}"
# LargeTitleAreaWarn           = "{{|LargeTitleArea|}}"
# LargeTitleAreaWarning        = "{{|LargeTitleArea|}}"
# LargeTitleAreaError          = "{{|LargeTitleArea|}}"
# LargeTitleAreaSuccess        = "{{|LargeTitleArea|}}"
# LargeTitleAreaQuestion       = "{{|LargeTitleArea|}}"
  LargeTitle                   = "{{|Title|}}"
# LargeTitleHelp               = "{{|LargeTitle|}}"
# LargeTitleNotice             = "{{|TitleNotice|}}"
# LargeTitleWarn               = "{{|TitleWarn|}}"
# LargeTitleWarning            = "{{|TitleWarning|}}"
# LargeTitleError              = "{{|TitleError|}}"
# LargeTitleSuccess            = "{{|TitleSuccess|}}"
# LargeTitleQuestion           = "{{|TitleQuestion|}}"
# LargeTitleFocusIndicator     = "{{|TitleFocusIndicator|}}"
# LargeTitleUnfocusedIndicator = "{{|TitleUnfocusedIndicator|}}"
# LargeTitleSubMenu            = "{{|TitleSubMenu|}}"
# LargeTitleSubMenuFocused     = "{{|TitleSubMenuFocused|}}"
# LargeTitleHelpFocused        = "{{|TitleHelpFocused|}}"
# LargeTitleNoticeFocused      = "{{|TitleNoticeFocused|}}"
# LargeTitleWarnFocused        = "{{|TitleWarnFocused|}}"
# LargeTitleWarningFocused     = "{{|TitleWarningFocused|}}"
# LargeTitleErrorFocused       = "{{|TitleErrorFocused|}}"
# LargeTitleSuccessFocused     = "{{|TitleSuccessFocused|}}"
# LargeTitleQuestionFocused    = "{{|TitleQuestionFocused|}}"
  LargeIconFocused             = "{{|IconFocused|}}"
  LargeIconPressed             = "{{[red:white:B]}}"              # = "{{|IconPressed|}}"

## Subtitles
  Subtitle    = "{{[-:-:R]}}"  # = "{{|Dialog|}}"
  CommandLine = "{{[-]}}"      # = "{{|Dialog|}}"

## Headings
  Heading               = "{{[-:-:-R]}}"   # = "{{|Title|}}"
  HeadingTag            = "{{[-:-:-B]}}"   # = "{{|Heading|}}"
  HeadingValue          = "{{[-:-:-BU]}}"  # = "{{|Heading|}}"
  HeadingAppDescription = "{{[-]}}"        # = "{{|Heading|}}"

## Menus
  TagBrackets                 = "{{|Dialog|}}"
  TagSpinner                  = ""                       # = "{{|Tag|}}"
  TagKey                      = "{{[red:blue]}}"         # = "{{[-:-:B]}}"
  Tag                         = "{{[white:blue]}}"       # = "{{[-:-:-]}}"
  Item                        = "{{[red:blue]}}"         # = "{{[-:-:-]}}"
  TagKeyFocused               = "{{[blue:red:B]}}"       # = "{{|TagFocused|}}"
  TagFocused                  = "{{[white:red]}}"        # = "{{[-:-:R]}}"
  ItemFocused                 = "{{[white:blue:B]}}"     # = "{{[-:-:R]}}"
# ResizeLine                  = "{{|ItemFocused|}}"
# ItemListFocused             = "{{|ItemFocused|}}"
# ItemListUserDefinedFocused  = "{{|ItemFocused|}}"
# ItemListUserTemplateFocused = "{{|ItemListFocused:::U|}}"
# ItemListDeprecated          = "{{|ItemListUserDefined|}}"
# ItemListDeprecatedFocused   = "{{|ItemListUserDefinedFocused|}}"
  ItemList                    = ""                       # = "{{|Item|}}"
  ItemListUserDefined         = "{{|ItemList:::R|}}"     # = "{{|Item|}}"
# ItemListUserTemplate        = "{{|ItemList:::U|}}"
  OptionValue                 = "{{[white:red:B]}}"      # = "{{|Dialog|}}"
  OptionValueFocused          = "{{|OptionValue:::B|}}"  # = "{{|TagFocused|}}"

## Help
# HelpTag  = "{{|Tag|}}"
# HelpItem = "{{|Dialog|}}"

## Checkboxes
# CheckboxOffFocused         = "{{|TagFocused|}}"
# CheckboxOnFocused          = "{{|TagKeyFocused|}}"
# CheckboxBracketsOffFocused = "{{|TagFocused|}}"
# CheckboxBracketsOnFocused  = "{{|TagFocused|}}"
# CheckboxOff                = "{{|Tag|}}"
# CheckboxOn                 = "{{|TagKey|}}"
# CheckboxBracketsOff        = "{{|Tag|}}"
# CheckboxBracketsOn         = "{{|Tag|}}"

## Radio buttons
# RadioOff                = "{{|CheckboxOff|}}"
# RadioOn                 = "{{|CheckboxOn|}}"
# RadioBracketsOff        = "{{|CheckboxBracketsOff|}}"
# RadioBracketsOn         = "{{|CheckboxBracketsOn|}}"
# RadioOffFocused         = "{{|CheckboxOffFocused|}}"
# RadioOnFocused          = "{{|CheckboxOnFocused|}}"
# RadioBracketsOffFocused = "{{|CheckboxBracketsOffFocused|}}"
# RadioBracketsOnFocused  = "{{|CheckboxBracketsOnFocused|}}"

## Buttons
  ButtonActive       = "{{[white:red:B]}}"             # = "{{[-:-:R]}}"
  ButtonInactive     = "{{|Dialog|}}"                  # = "{{[-:-:-]}}"
  ButtonSpinner      = ""                              # = "{{|ButtonActive|}}"
  LargeButtonSpinner = ""                              # = "{{|ButtonSpinner|}}"
  ButtonKeyActive    = "{{|ButtonActive|}}"
  ButtonKeyInactive  = "{{|ButtonInactive:$accent|}}"  # = "{{|ButtonInactive|}}"

## Icons
  IconFocused                 = "{{|ButtonActive|}}"            # = "{{[-:-:R]}}"
  IconPressed                 = "{{[red:white:B]}}"             # = "{{[-:-:RB]}}"
  IconInactive                = ""
  IconExitInactive            = "{{[::R]}}"                     # = "{{|IconInactive|}}"
# IconResizeUpInactive        = "{{[-]}}"
# IconResizeUpFocused         = "{{|IconFocused|}}"
# IconResizeUpPressed         = "{{|IconPressed|}}"
# LargeIconResizeUpInactive   = "{{|IconResizeUpInactive|}}"
# LargeIconResizeUpFocused    = "{{|LargeIconFocused|}}"
# LargeIconResizeUpPressed    = "{{|LargeIconPressed|}}"
# IconResizeDnInactive        = "{{[-]}}"
# IconResizeDnFocused         = "{{|IconFocused|}}"
# IconResizeDnPressed         = "{{|IconPressed|}}"
# LargeIconResizeDnInactive   = "{{|IconResizeDnInactive|}}"
# LargeIconResizeDnFocused    = "{{|LargeIconFocused|}}"
# LargeIconResizeDnPressed    = "{{|LargeIconPressed|}}"
# IconHelpInactive            = "{{|IconInactive|}}"
# IconHelpFocused             = "{{|IconFocused|}}"
# IconHelpPressed             = "{{|IconPressed|}}"
# LargeIconHelpInactive       = "{{|IconHelpInactive|}}"
# LargeIconHelpFocused        = "{{|LargeIconFocused|}}"
# LargeIconHelpPressed        = "{{|LargeIconPressed|}}"
# IconRefreshInactive         = "{{|IconInactive|}}"
# IconRefreshFocused          = "{{|IconFocused|}}"
# IconRefreshPressed          = "{{|IconPressed|}}"
# LargeIconRefreshInactive    = "{{|IconRefreshInactive|}}"
# LargeIconRefreshFocused     = "{{|LargeIconFocused|}}"
# LargeIconRefreshPressed     = "{{|LargeIconPressed|}}"
# LargeIconExitInactive       = "{{|IconExitInactive|}}"
# IconExitFocused             = "{{|IconFocused|}}"
# IconExitPressed             = "{{|IconPressed|}}"
# LargeIconExitFocused        = "{{|LargeIconFocused|}}"
# LargeIconExitPressed        = "{{|LargeIconPressed|}}"
# IconMaximizeInactive        = "{{|IconInactive|}}"
# IconMaximizeFocused         = "{{|IconFocused|}}"
# IconMaximizePressed         = "{{|IconPressed|}}"
# LargeIconMaximizeInactive   = "{{|IconMaximizeInactive|}}"
# LargeIconMaximizeFocused    = "{{|LargeIconFocused|}}"
# LargeIconMaximizePressed    = "{{|LargeIconPressed|}}"
# IconSideBySideInactive      = "{{|IconInactive|}}"
# IconSideBySideFocused       = "{{|IconFocused|}}"
# IconSideBySidePressed       = "{{|IconPressed|}}"
# LargeIconSideBySideInactive = "{{|IconSideBySideInactive|}}"
# LargeIconSideBySideFocused  = "{{|LargeIconFocused|}}"
# LargeIconSideBySidePressed  = "{{|LargeIconPressed|}}"
# IconStackedInactive         = "{{|IconInactive|}}"
# IconStackedFocused          = "{{|IconFocused|}}"
# IconStackedPressed          = "{{|IconPressed|}}"
# LargeIconStackedInactive    = "{{|IconStackedInactive|}}"
# LargeIconStackedFocused     = "{{|LargeIconFocused|}}"
# LargeIconStackedPressed     = "{{|LargeIconPressed|}}"

## Env editor variable types
  EnvBuiltin       = "{{[blue:white:-B]}}"  # = "{{[-:-:D]}}"
  EnvInvalid       = "{{[blue:red:-B]}}"    # = "{{|MarkerInvalid|}}"
  EnvDuplicate     = "{{[blue:red:-]}}"     # = "{{|Highlight|}}"
  EnvPendingDelete = "{{|Dialog:::DS|}}"    # = "{{[-:-:DS]}}"
  EnvReadOnly      = "{{|Dialog:::D|}}"     # = "{{[-:-:D]}}"

## Env editor
  LineComment  = "{{|Dialog:::RB|}}"    # = "{{[-:-:D]}}"
  ModifiedText = "{{[white:blue:-B]}}"  # = "{{|Highlight|}}"

## Env editor line numbers
  LineNumber                = "{{|Dialog:::-D|}}"                 # = "{{[-:-:D]}}"
  LineNumberFocused         = "{{|Dialog:blue:::-B|}}"            # = "{{|TagFocused|}}"
  LineNumberModified        = "{{|ModifiedText:::-B|}}"           # = "{{|Highlight|}}"
  LineNumberModifiedFocused = "{{|LineNumberModified:red::-B|}}"  # = "{{|LineNumberModified|}}"
  LineNumberBrackets        = "{{|TagBrackets|}}"                 # = "{{|LineNumber|}}"

## Markers and cursor
  Marker                  = "{{[black:white:-]}}"
  MarkerAdded             = "{{|Marker::green|}}"       # = "{{|Highlight|}}"
  MarkerDeleted           = "{{|Marker::red|}}"         # = "{{|MarkerInvalid|}}"
  MarkerModified          = "{{|Marker::yellow|}}"      # = "{{|Highlight|}}"
  MarkerInvalid           = "{{[white:red:B]}}"         # = "{{[-:-:R]}}"
  MarkerLocked            = "{{|MarkerInvalid|}}"
# ButtonLockedMarker      = "{{|MarkerLocked|}}"
# LargeButtonLockedMarker = "{{|ButtonLockedMarker|}}"
# Prompt                  = ""
# PromptShell             = "{{|Highlight|}}"
# PromptSudo              = "{{|MarkerInvalid|}}"
  TextCursor              = "{{[:white:]}}"             # = "{{[-:-:R]}}"
# TextCursorFlash         = "{{|TextCursor:::R|}}"

## Scrollbar
  Scrollbar       = "{{|Border2|}}"  # = "{{[-:-:D]}}"
  ScrollbarThumb  = "{{|Border|}}"   # = "{{|Scrollbar|}}"
  ScrollbarArrows = "{{|Border|}}"   # = "{{|Scrollbar|}}"

## Keys, progress, and indicators
  KeyCap             = "{{[::-R]}}"           # = "{{[-:-:R]}}"
  ProgressWaiting    = "{{[white:black]}}"    # = "{{[-:-:D]}}"
  ProgressInProgress = "{{[white:black:B]}}"  # = "{{|Highlight|}}"
  ProgressCompleted  = "{{[black:white]}}"    # = "{{|Highlight|}}"

## Inline text highlights
  Highlight       = "{{|Dialog:blue:::B|}}"  # = "{{[-:-:B]}}"
# ApplicationName = "{{|Highlight|}}"
# RunningCommand  = "{{|Highlight|}}"
  FailingCommand  = "{{|TitleError|}}"       # = "{{|MarkerInvalid|}}"
# UserCommand     = "{{|Highlight|}}"
# Branch          = "{{|Highlight|}}"
# Version         = "{{|Highlight|}}"
# MenuPage        = "{{|Highlight|}}"
# File            = "{{|Highlight|}}"
# Folder          = "{{|Highlight|}}"
# App             = "{{|Highlight|}}"
# UserApp         = "{{|Highlight|}}"
# IPAddress       = "{{|Highlight|}}"
  URL             = "{{|Highlight:::U|}}"    # = "{{[-:-:U]}}"
# Var             = "{{|Highlight|}}"
# User            = "{{|Highlight|}}"
# Theme           = "{{|Highlight|}}"
  Yes             = "{{|TitleSuccess|}}"     # = "{{|Highlight|}}"
  No              = "{{|TitleError|}}"

[defaults]
# borders              = true
# large_buttons        = true
# large_title_bars     = true
# line_characters      = true
  shadow               = true          # = true
# shadow_level         = 2
# scrollbar            = true
# spinner              = true
  menu_brackets        = true          # = true
# checkbox_brackets    = "always"
# radio_brackets       = "always"
  border_color         = 3             # = 3
  dialog_title_align   = "center"      # = "center"
  submenu_title_align  = "left"        # = "left"
  panel_title_align    = "center"      # = "center"
# tab_layout           = "sidebyside"
  line_number_brackets = true          # = true
