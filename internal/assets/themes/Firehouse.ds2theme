[metadata]
name = "Firehouse"
description = "DockSTARTer2 Firehouse theme"
author = "Westlin"

[syntax]
semantic_prefix = "{{|"
semantic_suffix = "|}}"
direct_prefix   = "{{["
direct_suffix   = "]}}"

[palette]
primary = "red"
secondary = "black"
accent = "white"

[styles]
# Backdrop
Screen = "{{[$primary:$secondary]}}"
StatusBar = "{{[$secondary:$primary]}}"
StatusBarBorder = "{{|StatusBar|}}"

# Dialogs and panels
Dialog = "{{[$primary:$accent]}}"
Border = "{{[$primary:$accent]}}"
Border2 = "{{[$primary:$accent:D]}}"
Shadow = "{{|Screen:::D|}}"
ProgramBox = "{{[white:black:-]}}"
ConsoleBorder = "{{|Helpline|}}"

# Header bar
StatusFields = "{{|Screen|}}"
StatusName = "{{|StatusFields:::B|}}"
StatusVersion = "{{|StatusFields|}}"
StatusVersionBrackets = "{{|StatusFields|}}"
StatusVersionSpace = "{{|StatusBar|}}"
StatusVersionFocused = "{{|StatusVersion:::R|}}"
StatusFlags = "{{|StatusFields:::RB|}}"
StatusFlagsBrackets = "{{|StatusFields|}}"
StatusFlagsSpace = "{{|StatusFields|}}"
StatusUpdate = "{{|StatusVersion:::BU|}}"
StatusUpdateBrackets = "{{|StatusVersionBrackets|}}"
StatusUpdateMarker = "{{|StatusUpdate|}}"
StatusHostname = "{{|StatusFields|}}"
StatusBarFocused = "{{|TagFocused|}}"

# Titles
Title = "{{[$accent:$secondary:U]}}"
TitleHelp = "{{|Title|}}"
TitleNotice = "{{[white:green:B]}}"
TitleWarn = "{{[$secondary:$accent]}}"
TitleError = "{{[$secondary:$accent:B]}}"
TitleSuccess = "{{[$secondary:$accent]}}"
TitleWarning = "{{[$secondary:$accent]}}"
TitleQuestion = "{{[$secondary:$accent]}}"
TitleConsole = "{{|ConsoleBorder|}}"
TitleConsoleChangedIndicator = "{{|TitleNotice|}}"
TitleCheckbox = ""
TitleCheckboxFocused = "{{|TitleSubMenuFocused|}}"
TitleSubMenuFocused = "{{|Title:::R|}}"
TitleFocusIndicator = "{{[::-B]}}"
TitleUnfocusedIndicator = ""

# Large Titles
LargeTitleArea = "{{[white:red:-]}}"
LargeTitleAreaHelp = "{{|LargeTitleArea|}}"
LargeTitleAreaNotice = "{{|LargeTitleArea|}}"
LargeTitleAreaWarn = "{{|LargeTitleArea|}}"
LargeTitleAreaWarning = "{{|LargeTitleArea|}}"
LargeTitleAreaError = "{{|LargeTitleArea|}}"
LargeTitleAreaSuccess = "{{|LargeTitleArea|}}"
LargeTitleAreaQuestion = "{{|LargeTitleArea|}}"
LargeTitle = "{{|Title|}}"
LargeTitleHelp = "{{|LargeTitle|}}"
LargeTitleFocusIndicator = "{{[::R]}}"
LargeTitleUnfocusedIndicator = "{{|TitleUnfocusedIndicator|}}"
LargeTitleSubMenuFocused = ""
LargeIconFocused = "{{|IconFocused|}}"
LargeIconPressed = "{{[red:white:B]}}"

# Subtitles
Subtitle = "{{[-:-:R]}}"
CommandLine = "{{[-]}}"

# Headings
Heading = "{{[-:-:-R]}}"
HeadingTag = "{{[-:-:-B]}}"
HeadingValue = "{{[-:-:-BU]}}"
HeadingAppDescription = "{{[-]}}"

# Menus
TagBrackets = "{{|Dialog|}}"
TagSpinner = ""
TagKey = "{{|Dialog|}}"
Tag = "{{|Dialog:::B|}}"
Item = "{{|Dialog:::B|}}"
TagKeyFocused = "{{[$accent:$primary:B]}}"
TagFocused = "{{[yellow:red:B]}}"
ItemFocused = "{{[white:red:B]}}"
# Optional overrides -- uncomment and set to override that specifically;
# otherwise it falls back as noted above.
# ItemListFocused = ""
ItemList = "{{|Item|}}"
ItemListUserDefined = "{{[yellow:black:-]}}"
ItemListUserDefinedFocused = "{{|ItemListUserDefined:::B|}}"
ItemListDeprecated = "{{[red:black:-]}}"
ItemListDeprecatedFocused = "{{|ItemListDeprecated:::B|}}"
OptionValue = "{{|Dialog:::RB|}}"
OptionValueFocused = "{{|OptionValue:::RB|}}"

# Help
Helpline = "{{[$accent:$primary]}}"
HelpTag = "{{|Tag|}}"
HelpItem = "{{[$accent:$primary]}}"

# Checkboxes
# Checkbox*Focused optionally falls back to TagFocused if undefined --
# uncomment and set to override checkbox focus styling specifically.
# CheckboxOffFocused = ""
# CheckboxOnFocused = ""
# CheckboxBracketsOffFocused = ""
# CheckboxBracketsOnFocused = ""
CheckboxOff = "{{|Dialog|}}"
CheckboxOn = "{{|TagKey|}}"
CheckboxBracketsOff = "{{|Dialog|}}"
CheckboxBracketsOn = "{{|Dialog|}}"

# Radio buttons
# Radio* falls back to the matching Checkbox* tag automatically, and any
# Checkbox*Focused/Radio*Focused tag falls back further to TagFocused --
# uncomment and set to override radio buttons specifically.
# RadioOff = ""
# RadioOn = ""
# RadioBracketsOff = ""
# RadioBracketsOn = ""
# RadioOffFocused = ""
# RadioOnFocused = ""
# RadioBracketsOffFocused = ""
# RadioBracketsOnFocused = ""

# Buttons
ButtonActive = "{{[$accent:$primary:B]}}"
ButtonInactive = "{{|Dialog|}}"
ButtonSpinner = ""
ButtonSpinnerLarge = ""
ButtonKeyActive = "{{|ButtonActive|}}"
ButtonKeyInactive = "{{|ButtonInactive:::R|}}"

# Icons
# Per-widget icon tags (IconHelpInactive, IconMaximizeFocused, etc.) are
# optional overrides -- any not defined here fall back to the generic
# IconInactive/IconFocused/IconPressed below. Large* variants fall back the
# same way to LargeIconFocused/LargeIconPressed; Large*IconInactive falls
# back to its own small (non-Large) tag instead, since there's no generic
# LargeIconInactive.
IconFocused = "{{|ButtonActive|}}"
IconPressed = "{{[red:white:B]}}"
IconInactive = ""
IconExitInactive = "{{[::R]}}"
IconResizeUpInactive = "{{|ConsoleBorder|}}"
IconResizeDnInactive = "{{|ConsoleBorder|}}"
# Optional per-widget overrides -- uncomment and set to override that
# widget specifically; otherwise it falls back as described above.
# IconHelpInactive = ""
# IconHelpFocused = ""
# IconHelpPressed = ""
# LargeIconHelpInactive = ""
# LargeIconHelpFocused = ""
# LargeIconHelpPressed = ""
# IconRefreshInactive = ""
# IconRefreshFocused = ""
# IconRefreshPressed = ""
# LargeIconRefreshInactive = ""
# LargeIconRefreshFocused = ""
# LargeIconRefreshPressed = ""
# LargeIconExitInactive = ""
# IconExitFocused = ""
# IconExitPressed = ""
# LargeIconExitFocused = ""
# LargeIconExitPressed = ""
# IconMaximizeInactive = ""
# IconMaximizeFocused = ""
# IconMaximizePressed = ""
# LargeIconMaximizeInactive = ""
# LargeIconMaximizeFocused = ""
# LargeIconMaximizePressed = ""
# IconSideBySideInactive = ""
# IconSideBySideFocused = ""
# IconSideBySidePressed = ""
# LargeIconSideBySideInactive = ""
# LargeIconSideBySideFocused = ""
# LargeIconSideBySidePressed = ""
# IconStackedInactive = ""
# IconStackedFocused = ""
# IconStackedPressed = ""
# LargeIconStackedInactive = ""
# LargeIconStackedFocused = ""
# LargeIconStackedPressed = ""

# Env editor variable types
EnvBuiltin = "{{|Dialog:::B|}}"
EnvInvalid = "{{|Dialog:::D|}}"
EnvDuplicate = "{{|Dialog:::DR|}}"
EnvPendingDelete = "{{|Dialog:::DS|}}"
EnvReadOnly = "{{|Dialog:::D|}}"

# Env editor
LineComment = "{{|Dialog:::RB|}}"
ModifiedText = "{{|Dialog:::R|}}"

# Env editor line numbers
LineNumber = "{{|Dialog:::D|}}"
LineNumberFocused = "{{|Dialog:::B|}}"
LineNumberModified = "{{|ModifiedText|}}"
LineNumberModifiedFocused = "{{|LineNumberModified:::B|}}"
LineNumberBrackets = "{{|TagBrackets|}}"

# Markers and cursor
Marker = "{{[$secondary:$primary:-]}}"
MarkerAdded = "{{|Marker|}}"
MarkerDeleted = "{{|Marker|}}"
MarkerModified = "{{|Marker|}}"
MarkerInvalid = "{{|Marker:::B|}}"
MarkerLocked = "{{|MarkerInvalid|}}"
MarkerLockedLarge = "{{|MarkerLocked|}}"
TextCursor = "{{[:white:]}}"

# Scrollbar
Scrollbar = "{{|Border2|}}"
ScrollbarThumb = "{{|Border|}}"
ScrollbarArrows = "{{|Border|}}"

# Keys, progress, and indicators
KeyCap = "{{[::-R]}}"
ProgressWaiting = "{{[$accent:$secondary]}}"
ProgressInProgress = "{{[$accent:$secondary:B]}}"
ProgressCompleted = "{{[$secondary:$accent]}}"

# Inline text highlights
Highlight = "{{[$accent:$secondary:B]}}"
ApplicationName = "{{|Highlight|}}"
RunningCommand = "{{|Highlight|}}"
FailingCommand = "{{|TitleError|}}"
UserCommand = "{{|Highlight|}}"
Branch = "{{|Highlight|}}"
Version = "{{|Highlight|}}"
MenuPage = "{{|Highlight|}}"
File = "{{|Highlight|}}"
Folder = "{{|Highlight|}}"
App = "{{|Highlight|}}"
IPAddress = "{{|Highlight|}}"
URL = "{{|Highlight:::U|}}"
Var = "{{|Highlight|}}"
User = "{{|Highlight|}}"
Theme = "{{|Highlight|}}"
Yes = "{{|TitleSuccess|}}"
No = "{{|TitleError|}}"

[defaults]
dialog_title_align = "center"
submenu_title_align = "left"
panel_title_align = "center"
shadow = true
border_color = 3
menu_brackets = true
line_number_brackets = true
